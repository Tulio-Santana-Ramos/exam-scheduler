# --- Database ---------------------------------------------------------------
# Local docker compose database (see compose.yaml). Replace with the hosted URL in production.
# Run `db:migrate` against a DIRECT (non-pooled) URL: it takes a session-level advisory lock, which
# transaction-mode poolers (Neon/Supabase pooled endpoints) can split across backends.
DATABASE_URL=postgres://exam:exam@localhost:5433/exam_scheduler
# Integration tests TRUNCATE tables: never point this at a database you care about.
# The name must end in _test or the suite refuses to run.
TEST_DATABASE_URL=postgres://exam:exam@localhost:5433/exam_scheduler_test
DB_POOL_MAX=10
# Host port for the compose database (default 5433). Change it if the port is taken, and update the URLs above.
# DB_HOST_PORT=5433

# --- API --------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=8h
# Comma-separated list of web origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173
# Set to true behind a reverse proxy / hosting platform so client IPs (rate limiting, logs) are right.
TRUST_PROXY=false
LOGIN_RATE_LIMIT_MAX=10

# --- Clinic -----------------------------------------------------------------
CLINIC_TIME_ZONE=America/Sao_Paulo
CLINIC_OPEN_HOUR=7
CLINIC_CLOSE_HOUR=19

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=info
# json (default, for Loki and log drains) or pretty (readable local terminal output)
LOG_FORMAT=json
SERVICE_NAME=exam-scheduler-api
# Optional: push logs straight to Grafana Cloud Loki (all three or none). See docs/decisions/0003.
# LOKI_URL=https://logs-prod-XXX.grafana.net
# LOKI_USER=
# LOKI_API_KEY=

# --- Web (build time, apps/web) -----------------------------------------------
# VITE_API_URL=http://localhost:3000
# VITE_SHOW_DEMO_ACCOUNTS=true   # one-click demo logins on the sign-in page (demo only)
