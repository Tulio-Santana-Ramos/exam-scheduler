# deploy/.env.hosting  (gitignored) - where things go, no secrets
NEON_PROJECT_ID=
NEON_BRANCH=production
GCP_PROJECT_ID=
GCP_REGION=us-central1
CLOUD_RUN_SERVICE=exam-api
PAGES_PROJECT=exam-scheduler-web

# deploy/.env.migrate  (gitignored) - Neon DIRECT url, used only by deploy/migrate.sh
# DATABASE_URL=

# deploy/.env.api  (gitignored) - runtime config for Cloud Run. DATABASE_URL (pooled), JWT_SECRET and
# LOKI_API_KEY go to Secret Manager; everything else becomes plain Cloud Run env vars.
# DATABASE_URL= JWT_SECRET= CORS_ORIGIN= TRUST_PROXY=true DB_POOL_MAX=5 RUN_MIGRATIONS=false RUN_SEED=false
# LOG_FORMAT=json LOG_LEVEL=info LOKI_URL= LOKI_USER= LOKI_API_KEY=

# apps/web/.env.production.local  (gitignored) - read by `vite build` only
# VITE_API_URL=https://<cloud-run-url>  VITE_SHOW_DEMO_ACCOUNTS=true
